rules_version = '2';
/* ============================================================
   ClearSky-OMEGA · MERGED rules for the clearsky-portal database
   - OMEGA workspace /projects (isAdmin() cross-org exception)
   - Team Hub: team_todos, team_messages, team_members,
     team_conversations, team_convo_messages
   - Financing portal: fin_profiles, fin_projects (+ offers, inquiries)
     roles: developer | originator | partner | fin admin (allowlisted)
   - Distribution Marketplace: mkt_profiles, mkt_distributors (+ catalog),
     mkt_projects (+ quote, invoice, messages)
   - VDC Exchange: vdc_profiles, vdc_assets, vdc_rfqs, vdc_quotes,
     vdc_connectors, vdc_events
   - Shared partnerAllowlist (PUBLIC read; OPEN registration)
   - Tool registry /tools + /meta, and per-tenant /toolData
   - Admin console shared data /admin
       · /admin/improvements  → any signed-in user may read + write
         (shared Tool Improvement board across every tenant portal)
       · /admin/{other}       → any signed-in user may READ; only
         ClearSky admins may WRITE
   - Site Lifecycle Console: slc_* + omega_orgs (tier registry)
   - O&M / Operations Suite: om_*, sla_*, fs_*, rpt_*, fc_*
   - DEMO BUCKETS (demo.clearskyomega.com sales sandbox): three demo
     email domains may read/write ONLY their own dedicated demo orgId
     ('demo-clearsky' / 'demo-sunesol' / 'demo-ogisolar'). These orgIds
     are NOT real tenants, so real tenant data is never exposed.
   - CONSOLE VIEWERS (admin console read-only collaborators): sunesol.com
     and ogisolar.com may READ every /projects doc cross-org (so they see
     the Recent Projects grid) but may NOT create/update/delete cross-org.
   Deploying replaces the WHOLE database's rules, so everything lives here.
   ============================================================ */
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    /* email-domain org id — used by the OMEGA projects rules + tool data */
    function userOrg() {
      return request.auth.token.email.split('@')[1];
    }

    /* ============================================================
       DEMO BUCKET HELPERS  (demo.clearskyomega.com sales sandbox)
       ------------------------------------------------------------
       The demo portal forces three login domains into dedicated demo
       orgIds that are NOT real tenants:
         @clearsky-usa.com -> demo-clearsky
         @sunesol.com      -> demo-sunesol
         @ogisolar.com     -> demo-ogisolar
       These helpers let ONLY those domains touch ONLY their own demo
       bucket. Because the demo orgIds differ from every real orgId
       (which are the raw email domains), no real tenant data — including
       the REAL sunesol.com / ogisolar.com / clearsky-usa.com data — is
       ever reachable through a demo bucket, and demo writes never land
       in a real tenant. Real portals keep using userOrg()==orgId and are
       completely unaffected by these clauses.
       ============================================================ */
    function demoBucketOrg() {
      return userOrg() == 'clearsky-usa.com' ? 'demo-clearsky'
           : userOrg() == 'sunesol.com'      ? 'demo-sunesol'
           : userOrg() == 'ogisolar.com'     ? 'demo-ogisolar'
           : '';
    }
    /* True only when `org` is exactly the demo bucket assigned to the
       signed-in user's domain. Never matches a real orgId. */
    function ownsDemoBucket(org) {
      return signedIn() && demoBucketOrg() != '' && org == demoBucketOrg();
    }

    /* internal ClearSky team — may publish the tool catalog, onboard
       distributors, administer the marketplace, AND manage every OMEGA
       project from the admin console regardless of the project's orgId. */
    function isAdmin() {
      return signedIn() && (
        request.auth.token.email.matches('.*@clearsky-usa[.]com')
        || request.auth.token.email.matches('.*@csebuilders[.]com')
      );
    }
    /* Admin console read-only collaborators. These domains may READ every
       /projects doc cross-org (so the Recent Projects grid populates), but
       they are NOT admins — they get no cross-org write, and none of the
       admin-only write powers elsewhere in this file. */
    function isConsoleViewer() {
      return signedIn() && (
        isAdmin()
        || request.auth.token.email.matches('.*@sunesol[.]com')
        || request.auth.token.email.matches('.*@ogisolar[.]com')
      );
    }
    function myProfile() {
      return get(/databases/$(database)/documents/fin_profiles/$(request.auth.uid)).data;
    }
    function myRole() {
      return myProfile().role;
    }
    function isDeveloper() {
      return signedIn() && myRole() == 'developer';
    }
    function isPartner() {
      return signedIn() && myRole() == 'partner';
    }
    function isOriginator() {
      return signedIn() && myRole() == 'originator';
    }
    /* anyone who may bring a deal to the financing marketplace */
    function isSubmitter() {
      return signedIn() && myRole() in ['developer', 'originator'];
    }
    /* Financing marketplace operator. NOTE: deliberately NOT called
       isAdmin() — that name is already taken above by the ClearSky
       email-domain check and is used across every other portal in this
       file. This one is the fin_profiles role, and it is read-only. */
    function isFinAdmin() {
      return signedIn() && myRole() == 'admin';
    }
    /* The financing portal's organisation key — the folded form of the
       organisation name the person registered with. Used to scope the
       per-firm view records below. Read with a default so a profile written
       before orgKey existed returns '' rather than failing the whole rule. */
    function myFinOrgKey() {
      return myProfile().get('orgKey', '');
    }
    /* ---------------- marketplace role helpers ---------------- */
    function mktProfile() {
      return get(/databases/$(database)/documents/mkt_profiles/$(request.auth.uid)).data;
    }
    function mktRole() {
      return mktProfile().role;
    }
    function isMktDeveloper() {
      return signedIn() && mktRole() == 'developer';
    }
    function isMktDistributor() {
      return signedIn() && mktRole() == 'distributor';
    }
    function myDistId() {
      return mktProfile().distributorId;
    }
    /* Approved distributor email domains. Add more here as you onboard
       new distribution partners. */
    function isDistributorDomain() {
      return signedIn() && (
        request.auth.token.email.matches('.*@clearsky-usa[.]com')
        || request.auth.token.email.matches('.*@rexelusa[.]com')
      );
    }
    /* ---------------- VDC Exchange role helpers ----------------
       Operators are the three companies that run the exchange:
       ClearSky, Molecule Systems, Lightsmith Energy. Membership is
       decided by email domain (like isAdmin / isDistributorDomain),
       NOT by a profile read — so it never deadlocks on first login. */
    function isVdcOperatorDomain() {
      return signedIn() && (
        request.auth.token.email.matches('.*@clearsky-usa[.]com')
        || request.auth.token.email.matches('.*@csebuilders[.]com')
        || request.auth.token.email.matches('.*@moleculesystems[.]com')
        || request.auth.token.email.matches('.*@molecule[.]io')
        || request.auth.token.email.matches('.*@lightsmithenergy[.]com')
        || request.auth.token.email.matches('.*@lightsmith[.]energy')
      );
    }
    /* Which operator org a signed-in operator belongs to (for connector
       ownership checks). Returns '' for non-operators. */
    function vdcOperatorOrg() {
      return (request.auth.token.email.matches('.*@clearsky-usa[.]com')
              || request.auth.token.email.matches('.*@csebuilders[.]com')) ? 'clearsky'
           : (request.auth.token.email.matches('.*@moleculesystems[.]com')
              || request.auth.token.email.matches('.*@molecule[.]io')) ? 'molecule'
           : (request.auth.token.email.matches('.*@lightsmithenergy[.]com')
              || request.auth.token.email.matches('.*@lightsmith[.]energy')) ? 'lightsmith'
           : '';
    }
    /* ---------------- shared partner allowlist ----------------
       PUBLIC read so any pre-auth signup flow can consult it.
       Writes remain locked to the internal ClearSky team. */
    match /partnerAllowlist/{email} {
      allow read: if true;
      allow write: if isAdmin();
    }
    /* ============================================================
       ADMIN CONSOLE  —  shared internal source of truth.

       The Tool Improvement board (admin/improvements) is a SHARED
       bug/feature log that every tenant portal (SUN, NextNRG, etc.)
       reads and writes, so it stays open to any signed-in user. The
       rest of /admin (clients, partners, offerings, logs) is readable
       by any signed-in user but writable only by ClearSky admins.

       NOTE: the more-specific match on /admin/improvements takes
       precedence over the general /admin/{docId} match for that doc.
       ============================================================ */
    match /admin/improvements {
      allow read:  if signedIn();
      allow write: if signedIn();
    }
    match /admin/{docId} {
      allow read:  if signedIn();
      allow write: if isAdmin();
    }
    /* ============================================================
       TOOL REGISTRY
       ============================================================ */
    match /tools/{toolId} {
      allow read:  if signedIn();
      allow write: if isAdmin();
    }
    match /meta/{docId} {
      allow read:  if signedIn();
      allow write: if isAdmin();
    }
    /* ============================================================
       PER-TENANT TOOL DATA
       Demo buckets may read/write their own demo orgId under toolData.
       ============================================================ */
    match /toolData/{orgId}/tools/{toolKey} {
      allow read:  if signedIn() && (userOrg() == orgId || ownsDemoBucket(orgId) || isAdmin());
      allow write: if signedIn() && (userOrg() == orgId || ownsDemoBucket(orgId));
    }
    match /toolData/{orgId}/prefs/{prefId} {
      allow read:  if signedIn() && (userOrg() == orgId || ownsDemoBucket(orgId) || isAdmin());
      allow write: if signedIn() && (userOrg() == orgId || ownsDemoBucket(orgId));
    }
    /* ============================================================
       TEAM HUB — to-dos, company board, member profiles, and
       conversations (1:1 + groups). Scoped per tenant by orgId
       (email domain), exactly like /projects. One deploy to this
       shared database enables the Team Hub in EVERY tenant repo.
       NOTE: the client stores all emails lowercased, so equality
       checks against request.auth.token.email are safe.
       Demo buckets are supported so the demo dashboard's Team Hub
       works — scoped to the demo orgId, isolated from real orgs.
       ============================================================ */

    /* -------- Team to-dos --------
       Any teammate in the same org (or the same demo bucket) may add,
       toggle done, edit, or delete. orgId is immutable on update. */
    match /team_todos/{docId} {
      allow read:   if signedIn() && (resource.data.orgId == userOrg() || ownsDemoBucket(resource.data.orgId) || isAdmin());
      allow create: if signedIn() && (request.resource.data.orgId == userOrg() || ownsDemoBucket(request.resource.data.orgId));
      allow update: if signedIn()
                    && (resource.data.orgId == userOrg() || ownsDemoBucket(resource.data.orgId))
                    && request.resource.data.orgId == resource.data.orgId;
      allow delete: if signedIn() && (resource.data.orgId == userOrg() || ownsDemoBucket(resource.data.orgId));
    }

    /* -------- Company message board --------
       Shared team space. Messages are immutable once posted; the author
       (or any teammate in the org) may delete. */
    match /team_messages/{docId} {
      allow read:   if signedIn() && (resource.data.orgId == userOrg() || ownsDemoBucket(resource.data.orgId) || isAdmin());
      allow create: if signedIn()
                    && (request.resource.data.orgId == userOrg() || ownsDemoBucket(request.resource.data.orgId))
                    && request.resource.data.authorEmail == request.auth.token.email;
      allow update: if false;
      allow delete: if signedIn()
                    && (resource.data.orgId == userOrg() || ownsDemoBucket(resource.data.orgId))
                    && resource.data.authorEmail == request.auth.token.email;
    }

    /* -------- Team member directory / profile (display name + photo) --------
       Doc id is "<orgId>__<email>". A user may only write their OWN member
       doc; everyone in the org (or demo bucket) may read the roster. */
    match /team_members/{memberId} {
      allow read:   if signedIn() && (resource.data.orgId == userOrg() || ownsDemoBucket(resource.data.orgId) || isAdmin());
      allow create: if signedIn()
                    && (request.resource.data.orgId == userOrg() || ownsDemoBucket(request.resource.data.orgId))
                    && request.resource.data.email == request.auth.token.email
                    && memberId == request.resource.data.orgId + '__' + request.auth.token.email;
      allow update: if signedIn()
                    && (resource.data.orgId == userOrg() || ownsDemoBucket(resource.data.orgId))
                    && resource.data.email == request.auth.token.email
                    && request.resource.data.orgId == resource.data.orgId
                    && request.resource.data.email == resource.data.email;
      allow delete: if false;
    }

    /* -------- Conversations (1:1 + named groups) --------
       A conversation lists its participants in members[] (array of emails).
       You may read/write a conversation only if you're a member, within your
       org (or demo bucket). */
    match /team_conversations/{convoId} {
      allow read:   if signedIn()
                    && (resource.data.orgId == userOrg() || ownsDemoBucket(resource.data.orgId))
                    && request.auth.token.email in resource.data.members;
      allow create: if signedIn()
                    && (request.resource.data.orgId == userOrg() || ownsDemoBucket(request.resource.data.orgId))
                    && request.auth.token.email in request.resource.data.members;
      allow update: if signedIn()
                    && (resource.data.orgId == userOrg() || ownsDemoBucket(resource.data.orgId))
                    && request.auth.token.email in resource.data.members
                    && request.resource.data.orgId == resource.data.orgId
                    && request.resource.data.kind == resource.data.kind;
      allow delete: if signedIn()
                    && (resource.data.orgId == userOrg() || ownsDemoBucket(resource.data.orgId))
                    && resource.data.createdBy == request.auth.token.email;
    }

    /* -------- Conversation messages --------
       Readable/writable only by members of the parent conversation. */
    match /team_convo_messages/{msgId} {
      function convoNew() {
        return get(/databases/$(database)/documents/team_conversations/$(request.resource.data.convoId)).data;
      }
      function convoCur() {
        return get(/databases/$(database)/documents/team_conversations/$(resource.data.convoId)).data;
      }
      allow read:   if signedIn()
                    && (resource.data.orgId == userOrg() || ownsDemoBucket(resource.data.orgId))
                    && request.auth.token.email in convoCur().members;
      allow create: if signedIn()
                    && (request.resource.data.orgId == userOrg() || ownsDemoBucket(request.resource.data.orgId))
                    && request.auth.token.email in convoNew().members;
      allow update, delete: if false;
    }

    /* ---------------- Financing portal user profiles ----------------
       OPEN registration is UNCHANGED for 'developer', 'partner', and the
       new 'originator' role: any signed-in user may create their own
       profile with any of those three. No allowlist gate, exactly as before.

       'admin' is the one exception. It reads EVERY deal in the financing
       marketplace, so it must not be self-assignable. It requires either
       a ClearSky staff email (isAdmin()) or an active partnerAllowlist
       entry for that email whose role is 'admin'. */
    match /fin_profiles/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && (
             request.resource.data.role in ['developer', 'originator', 'partner']
             || (
                  request.resource.data.role == 'admin'
                  && (
                       isAdmin()
                       || (
                            exists(/databases/$(database)/documents/partnerAllowlist/$(request.resource.data.emailLower))
                            && get(/databases/$(database)/documents/partnerAllowlist/$(request.resource.data.emailLower)).data.active == true
                            && get(/databases/$(database)/documents/partnerAllowlist/$(request.resource.data.emailLower)).data.role == 'admin'
                          )
                     )
                )
           );
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }
    /* ---------------- Financing portal organisations ----------------
       fin_orgs/{orgKey} holds a capital partner's tier, unlock allowance and
       the unlocks they have spent this period.

       NOTE: the app has been reading and writing this collection for some
       time but this file carried no rule for it, so every read failed and the
       tier always fell back to the default. Added here so deploying this file
       does not leave the entitlement system broken. If your live rules
       already carry a fin_orgs block, keep whichever is more restrictive. */
    match /fin_orgs/{orgKey} {
      allow read:  if signedIn();
      allow write: if isAdmin() || isFinAdmin();
      match /unlocks/{dealId} {
        allow read:   if signedIn();
        allow create: if isPartner() || isAdmin() || isFinAdmin();
        allow update: if isAdmin() || isFinAdmin();
        allow delete: if isAdmin() || isFinAdmin();
      }
    }
    /* ---------------- Financing portal settings ----------------
       fin_settings/intake holds the intake gate and the first-look defaults
       (which technologies queue for review, which partner gets first look,
       and how many days they have). Readable by any signed-in user, because
       every client needs it to decide what a newly filed deal becomes and to
       label a held deal correctly. Writable only by the marketplace operator. */
    match /fin_settings/{docId} {
      allow read:  if signedIn();
      allow write: if isAdmin() || isFinAdmin();
    }
    /* ---------------- Financing portal projects ---------------- */
    match /fin_projects/{projectId} {
      function isOwner() {
        return signedIn() && resource.data.developerUid == request.auth.uid;
      }
      function isAwardee() {
        return signedIn() && resource.data.awardedTo == request.auth.uid;
      }
      function isBrowsable() {
        // Partners browse only OPEN projects. 'draft', 'review', 'exclusive',
        // 'closed' and 'awarded' are all excluded.
        return resource.data.status == 'open';
      }
      /* The first-look partner. Membership is an array of uids written onto
         the deal when the hold starts, so this resolves without reading a
         profile — and so a partner's array-contains query returns only
         documents this same test will pass. Deliberately NOT gated on status
         here: the query cannot filter on status as well, and every document
         carrying the uid is one this partner was given.
         Every access below uses data.get(field, default) because deals filed
         before this feature existed have none of these fields, and a bare
         reference to a missing field fails the whole rule — which would have
         locked sponsors out of editing their own older deals. */
      function isFirstLook() {
        return isPartner()
               && request.auth.uid in resource.data.get('firstLookUids', []);
      }
      /* Is the exclusive window still running? Compared against the server's
         clock, not the browser's, so a partner cannot buy themselves more
         time by moving their system clock. */
      function holdIsLive() {
        return resource.data.get('firstLookUntil', 0) is number
               && request.time.toMillis() < resource.data.get('firstLookUntil', 0);
      }
      // Read granted if you own it (developer or originator), or you're
      // ClearSky staff / a financing admin, or you're a partner and it's
      // browsable (open), or you hold the first look on it, or you're the
      // awarded partner.
      // Order matters: isOwner() and isAdmin() need no profile read, so a
      // user with no fin_profile short-circuits out before myRole() runs.
      allow read: if isOwner()
                  || isAdmin()
                  || isFinAdmin()
                  || (isPartner() && isBrowsable())
                  || isFirstLook()
                  || (isPartner() && isAwardee());
      // CREATE: developers AND originators may submit a deal. A deal may be
      // filed as a draft, into the review queue, or straight onto the
      // marketplace — but never pre-held for a partner, and never pre-awarded.
      allow create: if isSubmitter()
                    && request.resource.data.developerUid == request.auth.uid
                    && request.resource.data.status in ['draft', 'review', 'open']
                    && request.resource.data.awardedTo == null
                    && request.resource.data.get('firstLookUids', []).size() == 0;
      // Owner (developer or originator) may edit their own deal
      // (developerUid fixed). This also covers awarding and closing.
      // A sponsor may NOT put their own deal on a first-look hold — only the
      // operator does that — so the hold fields are pinned on their writes.
      allow update: if isOwner()
                    && request.resource.data.developerUid == resource.data.developerUid
                    && request.resource.data.get('firstLookUids', [])
                       == resource.data.get('firstLookUids', [])
                    && (
                         // ordinary edit: the hold, if any, is left alone
                         request.resource.data.get('firstLookUntil', 0)
                           == resource.data.get('firstLookUntil', 0)
                         // or the sponsor clears a hold whose window has run out
                         || (resource.data.status == 'exclusive'
                             && !holdIsLive()
                             && request.resource.data.status == 'open')
                       );
      // The marketplace operator approves deals out of the review queue, puts
      // them on a first-look hold, releases them, and sends them back.
      // NOTE: this is a deliberate change — the financing admin used to have
      // no write access at all. It cannot award a deal to itself: awardedTo
      // may only be set by the owner's rule above.
      allow update: if (isAdmin() || isFinAdmin())
                    && request.resource.data.developerUid == resource.data.developerUid
                    && request.resource.data.get('awardedTo', null)
                       == resource.data.get('awardedTo', null);
      /* The first-look partner has exactly one write on the project: passing,
         which releases it to the marketplace. hasOnly() pins every other
         field, so this cannot be used to touch the numbers, the owner, or the
         award. Allowed after the window closes too — passing late is still a
         pass, and it saves waiting for a sweep. */
      allow update: if isFirstLook()
                    && resource.data.status == 'exclusive'
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'firstLookUids', 'firstLookPastUids',
                                   'firstLookDecision', 'firstLookDecidedAt',
                                   'firstLookDecidedBy', 'firstLookUntil'])
                    && request.resource.data.status == 'open'
                    && request.resource.data.get('firstLookUids', []).size() == 0;
      /* Taking the first look only stamps the decision — the hold stays on,
         so the deal does not reach the open marketplace while terms are
         worked out. Only allowed while the window is actually live. */
      allow update: if isFirstLook()
                    && resource.data.status == 'exclusive'
                    && holdIsLive()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['firstLookDecision', 'firstLookDecidedAt', 'firstLookDecidedBy'])
                    && request.resource.data.firstLookDecision == 'accepted';
      allow delete: if (isOwner() && resource.data.status != 'awarded')
                    || isAdmin() || isFinAdmin();
      /* ---------------- per-firm view records ----------------
         fin_projects/{id}/fin_views/{orgKey} — one document per capital firm
         per deal, carrying an open count and the strongest signal they have
         given. Written by the partner who looked; read by the sponsor whose
         deal it is, and by the operator.

         The document id IS the writer's organisation key, so a firm can only
         ever write its own record — there is no path on which one partner
         could write, alter, or inflate another's. */
      match /fin_views/{orgKey} {
        function parent() {
          return get(/databases/$(database)/documents/fin_projects/$(projectId)).data;
        }
        function isMyFirm() {
          return isPartner() && myFinOrgKey() != '' && orgKey == myFinOrgKey();
        }
        /* A capital partner may read only their own firm's record — never a
           rival's. Seeing who else is circling a deal is exactly what this
           collection is for and exactly what must not leak sideways. */
        allow read: if isAdmin()
                    || isFinAdmin()
                    || parent().developerUid == request.auth.uid
                    || parent().get('orgKey', '\u0000') == myFinOrgKey()
                    || isMyFirm();
        /* Writable only against a deal the partner can actually see, so a
           record cannot be manufactured for a deal in the review queue or one
           held for somebody else. sponsorOrgKey is checked against the parent
           rather than trusted, because the sponsor's own query filters on it. */
        allow create, update: if isMyFirm()
                    && request.resource.data.orgKey == orgKey
                    && request.resource.data.sponsorOrgKey == parent().get('orgKey', '')
                    && (
                         parent().status == 'open'
                         || parent().get('awardedTo', '') == request.auth.uid
                         || request.auth.uid in parent().get('firstLookUids', [])
                       );
        allow delete: if isAdmin() || isFinAdmin();
      }
      match /offers/{offerId} {
        function parent() {
          return get(/databases/$(database)/documents/fin_projects/$(projectId)).data;
        }
        function parentOwner() {
          return parent().developerUid == request.auth.uid;
        }
        /* A partner may only bid on a deal that is genuinely open to them:
           on the marketplace, or held for them with the window still live.
           Without this, a partner who kept a deal id could bid on something
           in the review queue or on another partner's exclusive. */
        function parentBiddable() {
          return parent().status == 'open'
                 || (parent().status == 'exclusive'
                     && request.auth.uid in parent().get('firstLookUids', [])
                     && request.time.toMillis() < parent().get('firstLookUntil', 0));
        }
        allow read: if signedIn() && (
                       parentOwner() ||
                       isAdmin() ||
                       isFinAdmin() ||
                       (isPartner() && offerId == request.auth.uid)
                    );
        allow create, update: if isPartner()
                    && offerId == request.auth.uid
                    && request.resource.data.partnerUid == request.auth.uid
                    && parent().status != 'awarded'
                    && parentBiddable();
        allow update: if parentOwner()
                    || (isPartner() && offerId == request.auth.uid);
        allow delete: if false;
      }
      match /inquiries/{msgId} {
        function parent() {
          return get(/databases/$(database)/documents/fin_projects/$(projectId)).data;
        }
        function parentOwner() {
          return parent().developerUid == request.auth.uid;
        }
        function parentAwardee() {
          return parent().awardedTo == request.auth.uid;
        }
        function parentBrowsable() {
          return parent().status == 'open';
        }
        function parentHeldForMe() {
          return parent().status == 'exclusive'
                 && request.auth.uid in parent().get('firstLookUids', []);
        }
        allow read: if signedIn() && (
                       parentOwner() ||
                       isAdmin() ||
                       isFinAdmin() ||
                       (isPartner() && (parentBrowsable() || parentHeldForMe() || parentAwardee()))
                    );
        allow create: if signedIn()
                    && request.resource.data.authorUid == request.auth.uid
                    && (
                        parentOwner() ||
                        (isPartner() && (parentBrowsable() || parentHeldForMe() || parentAwardee()))
                       );
        allow update, delete: if false;
      }
    }
    /* ---------------- view records, collection-group scope ----------------
       A sponsor reads engagement across their whole book in one query:

         collectionGroup('fin_views').where('sponsorOrgKey','==', myOrgKey())

       A collection-group query is NOT authorised by the nested rule above —
       it needs a rule matched at the group path, which is why this exists
       separately. The subcollection is named fin_views rather than views
       precisely because this wildcard reaches across the whole shared
       database, and a bare "views" would match any other portal's data.

       Empty org keys are excluded on both sides: a profile written before
       orgKey existed must not match every record whose sponsorOrgKey is also
       blank. Read-only here — every write goes through the nested rule, which
       can check the parent deal. */
    match /{path=**}/fin_views/{orgKey} {
      allow read: if isAdmin()
                  || isFinAdmin()
                  || (myFinOrgKey() != ''
                      && resource.data.get('sponsorOrgKey', '\u0000') == myFinOrgKey())
                  || (isPartner() && myFinOrgKey() != '' && orgKey == myFinOrgKey());
      allow write: if false;
    }
    /* ============================================================
       DISTRIBUTION MARKETPLACE — mkt_*
       ============================================================ */
    /* -------- marketplace profiles -------- */
    match /mkt_profiles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && (
            request.resource.data.role == 'developer'
            || isAdmin()
            || (request.resource.data.role == 'distributor' && isDistributorDomain())
           );
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.distributorId == resource.data.distributorId;
      allow delete: if false;
    }
    /* -------- distributors (onboarded suppliers) -------- */
    match /mkt_distributors/{distId} {
      allow read: if signedIn();
      allow create: if isAdmin();
      allow update: if isAdmin()
                    || (isMktDistributor() && myDistId() == distId);
      allow delete: if isAdmin();
      match /catalog/{productId} {
        allow read: if signedIn();
        allow create, update, delete: if isAdmin()
                    || (isMktDistributor() && myDistId() == distId);
      }
    }
    /* -------- marketplace projects (developer -> distributor) -------- */
    match /mkt_projects/{projectId} {
      function isProjDev() {
        return signedIn() && resource.data.developerUid == request.auth.uid;
      }
      function isTargetDistributor() {
        return isMktDistributor() && resource.data.targetDistId == myDistId();
      }
      allow read: if isProjDev() || isTargetDistributor() || isAdmin();
      allow create: if isMktDeveloper()
                    && request.resource.data.developerUid == request.auth.uid
                    && request.resource.data.status == 'submitted';
      allow update: if (isProjDev()
                        && request.resource.data.developerUid == resource.data.developerUid
                        && request.resource.data.targetDistId == resource.data.targetDistId)
                    || isTargetDistributor()
                    || isAdmin();
      allow delete: if (isProjDev() && resource.data.status == 'submitted') || isAdmin();
      function pParent() {
        return get(/databases/$(database)/documents/mkt_projects/$(projectId)).data;
      }
      function pIsDev() {
        return signedIn() && pParent().developerUid == request.auth.uid;
      }
      function pIsDist() {
        return isMktDistributor() && pParent().targetDistId == myDistId();
      }
      match /quote/{quoteId} {
        allow read: if pIsDev() || pIsDist() || isAdmin();
        allow create, update: if pIsDist() || isAdmin();
        allow delete: if isAdmin();
      }
      match /invoice/{invoiceId} {
        allow read: if pIsDev() || pIsDist() || isAdmin();
        allow create, update: if pIsDist() || isAdmin()
                    || (pIsDev()
                        && request.resource.data.provider == resource.data.provider
                        && request.resource.data.amount == resource.data.amount);
        allow delete: if isAdmin();
      }
      match /messages/{msgId} {
        allow read: if pIsDev() || pIsDist() || isAdmin();
        allow create: if signedIn()
                    && request.resource.data.authorUid == request.auth.uid
                    && (pIsDev() || pIsDist() || isAdmin());
        allow update, delete: if false;
      }
    }
    /* ============================================================
       VDC EXCHANGE — vdc_*
       Buyers/sellers self-register (role 'buyer'); operators are the
       three exchange companies, gated by email domain
       (isVdcOperatorDomain) so no profile read is needed to authorize.
       Profile reads elsewhere are guarded with exists() to avoid a
       first-login deadlock.
       ============================================================ */
    /* -------- VDC profiles --------
       OPEN registration: any signed-in user creates their own profile.
       Role is self-asserted 'buyer' or 'operator'; operators additionally
       must be on an approved operator domain. */
    match /vdc_profiles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isVdcOperatorDomain());
      allow create: if signedIn() && request.auth.uid == uid
        && (
            request.resource.data.role == 'buyer'
            || (request.resource.data.role == 'operator' && isVdcOperatorDomain())
           );
      allow update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }
    /* -------- VDC assets (powered data assets + compute SKUs) -------- */
    match /vdc_assets/{id} {
      allow read: if signedIn() && (
                    resource.data.ownerUid == request.auth.uid
                    || isVdcOperatorDomain()
                    || resource.data.status == 'live'
                    || resource.data.status == 'matched'
                  );
      allow create: if signedIn()
                    && request.resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn() && (
                      resource.data.ownerUid == request.auth.uid
                      || isVdcOperatorDomain()
                    );
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }
    /* -------- VDC RFQs (buyer quote requests) -------- */
    match /vdc_rfqs/{id} {
      allow read: if signedIn() && (
                    resource.data.buyerUid == request.auth.uid
                    || isVdcOperatorDomain()
                  );
      allow create: if signedIn()
                    && request.resource.data.buyerUid == request.auth.uid;
      allow update: if signedIn() && (
                      resource.data.buyerUid == request.auth.uid
                      || isVdcOperatorDomain()
                    );
      allow delete: if signedIn() && resource.data.buyerUid == request.auth.uid;
    }
    /* -------- VDC quotes (operator responses to an RFQ) -------- */
    match /vdc_quotes/{id} {
      allow read: if signedIn() && (
                    isVdcOperatorDomain()
                    || get(/databases/$(database)/documents/vdc_rfqs/$(resource.data.rfqId)).data.buyerUid == request.auth.uid
                  );
      allow create: if isVdcOperatorDomain()
                    && request.resource.data.providerUid == request.auth.uid;
      allow update: if isVdcOperatorDomain()
                    && resource.data.providerUid == request.auth.uid;
      allow delete: if isAdmin();
    }
    /* -------- VDC connectors (backend API integrations) --------
       Operators read all; writes limited to the owning org or ClearSky. */
    match /vdc_connectors/{key} {
      allow read: if isVdcOperatorDomain();
      allow write: if isVdcOperatorDomain() && (
                     vdcOperatorOrg() == 'clearsky'
                     || vdcOperatorOrg() == resource.data.owner
                     || vdcOperatorOrg() == request.resource.data.owner
                   );
    }
    /* -------- VDC events (append-only audit log) -------- */
    match /vdc_events/{id} {
      allow read: if isVdcOperatorDomain();
      allow create: if signedIn()
                    && request.resource.data.byUid == request.auth.uid;
      allow update, delete: if false;
    }
    /* ============================================================
       OMEGA workspace projects.
       Demo buckets ('demo-*') are allowed for the three demo domains,
       scoped so each demo login only sees its own demo bucket. Real
       tenant projects (orgId == real email domain) are unaffected.

       CONSOLE VIEWERS: sunesol.com / ogisolar.com (via isConsoleViewer)
       get cross-org READ so the admin console's Recent Projects grid
       populates for them. They do NOT get cross-org create/update/delete
       — those stay on isAdmin(), so collaborators can look but not touch
       projects outside their own org.
       ============================================================ */
    match /projects/{projectId} {
      allow read: if request.auth != null
                  && (
                    resource.data.orgId == userOrg()
                    || resource.data.uid == request.auth.uid
                    || ownsDemoBucket(resource.data.orgId)
                    || isConsoleViewer()
                  );
      allow create: if request.auth != null
                    && (
                      request.resource.data.orgId == userOrg()
                      || ownsDemoBucket(request.resource.data.orgId)
                      || isAdmin()
                    );
      allow update: if request.auth != null
                    && (
                      (
                        (
                          resource.data.orgId == userOrg()
                          || resource.data.uid == request.auth.uid
                        )
                        && request.resource.data.orgId == userOrg()
                      )
                      || (
                        ownsDemoBucket(resource.data.orgId)
                        && request.resource.data.orgId == resource.data.orgId
                      )
                      || isAdmin()
                    );
      allow delete: if request.auth != null
                    && (
                      resource.data.orgId == userOrg()
                      || resource.data.uid == request.auth.uid
                      || ownsDemoBucket(resource.data.orgId)
                      || isAdmin()
                    );
    }

    /* ============================================================
       SITE LIFECYCLE CONSOLE — slc_*  +  omega_orgs (tier registry)
       Add-on for the Site Lifecycle Console tool.
       Reuses your existing helpers: signedIn(), userOrg(), isAdmin().
       Tenant isolation by orgId == userOrg() (email domain), exactly
       like /projects and team_*. Admin (ClearSky) can cross-org, matching
       the isAdmin() exception you already use elsewhere.

       ============================================================ */

    /* -------- OMEGA org tier registry --------
       Doc id = org domain (e.g. "nextnrg.com"). Holds { tier, apps[] }.
       - Any signed-in user may READ their own org's tier (tools need it
         to decide entitlements); admins may read any.
       - Only ClearSky admins may WRITE tier. An org can NEVER upgrade
         itself — tier is sold/provisioned by ClearSky. */
    match /omega_orgs/{orgId} {
      allow read:  if signedIn() && (orgId == userOrg() || ownsDemoBucket(orgId) || isAdmin());
      allow write: if isAdmin();
    }

    /* -------- Site Lifecycle records --------
       candidates / leases / assets / permits / projects.
       orgId (email domain) scopes every record. orgId is immutable on
       update so records can't be moved between orgs. Admins cross-org.
       Demo buckets supported so the SLC tool works in the demo too. */

    match /slc_candidates/{id} {
      allow read:   if signedIn() && (resource.data.orgId == userOrg() || ownsDemoBucket(resource.data.orgId) || isAdmin());
      allow create: if signedIn() && (request.resource.data.orgId == userOrg() || ownsDemoBucket(request.resource.data.orgId));
      allow update: if signedIn()
                    && (resource.data.orgId == userOrg() || ownsDemoBucket(resource.data.orgId) || isAdmin())
                    && request.resource.data.orgId == resource.data.orgId;
      allow delete: if signedIn() && (resource.data.orgId == userOrg() || ownsDemoBucket(resource.data.orgId) || isAdmin());
    }

    match /slc_leases/{id} {
      allow read:   if signedIn() && (resource.data.orgId == userOrg() || ownsDemoBucket(resource.data.orgId) || isAdmin());
      allow create: if signedIn() && (request.resource.data.orgId == userOrg() || ownsDemoBucket(request.resource.data.orgId));
      allow update: if signedIn()
                    && (resource.data.orgId == userOrg() || ownsDemoBucket(resource.data.orgId) || isAdmin())
                    && request.resource.data.orgId == resource.data.orgId;
      allow delete: if signedIn() && (resource.data.orgId == userOrg() || ownsDemoBucket(resource.data.orgId) || isAdmin());
    }

    match /slc_assets/{id} {
      allow read:   if signedIn() && (resource.data.orgId == userOrg() || ownsDemoBucket(resource.data.orgId) || isAdmin());
      allow create: if signedIn() && (request.resource.data.orgId == userOrg() || ownsDemoBucket(request.resource.data.orgId));
      allow update: if signedIn()
                    && (resource.data.orgId == userOrg() || ownsDemoBucket(resource.data.orgId) || isAdmin())
                    && request.resource.data.orgId == resource.data.orgId;
      allow delete: if signedIn() && (resource.data.orgId == userOrg() || ownsDemoBucket(resource.data.orgId) || isAdmin());
    }

    match /slc_permits/{id} {
      allow read:   if signedIn() && (resource.data.orgId == userOrg() || ownsDemoBucket(resource.data.orgId) || isAdmin());
      allow create: if signedIn() && (request.resource.data.orgId == userOrg() || ownsDemoBucket(request.resource.data.orgId));
      allow update: if signedIn()
                    && (resource.data.orgId == userOrg() || ownsDemoBucket(resource.data.orgId) || isAdmin())
                    && request.resource.data.orgId == resource.data.orgId;
      allow delete: if signedIn() && (resource.data.orgId == userOrg() || ownsDemoBucket(resource.data.orgId) || isAdmin());
    }

    match /slc_projects/{id} {
      allow read:   if signedIn() && (resource.data.orgId == userOrg() || ownsDemoBucket(resource.data.orgId) || isAdmin());
      allow create: if signedIn() && (request.resource.data.orgId == userOrg() || ownsDemoBucket(request.resource.data.orgId));
      allow update: if signedIn()
                    && (resource.data.orgId == userOrg() || ownsDemoBucket(resource.data.orgId) || isAdmin())
                    && request.resource.data.orgId == resource.data.orgId;
      allow delete: if signedIn() && (resource.data.orgId == userOrg() || ownsDemoBucket(resource.data.orgId) || isAdmin());
    }

    /* -------- CRM config (NON-SECRET metadata only) --------
       Doc id = orgId (email domain). Holds provider name, connected flag,
       board/object targets, and field mappings. NO credentials here — CRM
       tokens live server-side in Upstash via /api/crm-sync. */
    match /slc_crm_config/{orgId} {
      allow read:  if signedIn() && (orgId == userOrg() || ownsDemoBucket(orgId) || isAdmin());
      allow write: if signedIn() && (orgId == userOrg() || ownsDemoBucket(orgId) || isAdmin());
    }

    /* ============================================================
       O&M / OPERATIONS SUITE  —  om_* · sla_* · fs_* · rpt_* · fc_*
       Add-on for the five post-COD operations consoles:
         · O&M Operations Console         (om_sites, om_tickets, om_techs, om_integrations)
         · SLA & Contractual Intelligence (sla_contracts/_events/_breaches)
         · Field Service & Dispatch       (fs_calls/_crews/_signals)
         · Owner Reporting & Audit         (rpt_owners/_reports; READS om_/sla_/fs_)
         · Fleet Command                   (fc_assets/_sources; READS om_sites)

       Same idiom as slc_* above: tenant isolation by orgId == userOrg()
       (email domain), orgId immutable on update, demo buckets supported,
       ClearSky admins cross-org via isAdmin(). Reuses signedIn(), userOrg(),
       ownsDemoBucket(), isAdmin() — no new helpers needed.

       om_integrations is keyed by orgId as the doc id (one per tenant), so
       it gates on the {orgId} path segment like omega_orgs / slc_crm_config
       — NOT on resource.data.orgId.
       ============================================================ */

    /* -------- O&M Operations Console --------
       Uses om_sites (fleet), om_tickets (work orders), om_techs
       (technician roster), and om_integrations (config, below). */
    match /om_sites/{id} {
      allow read:   if signedIn() && (resource.data.orgId == userOrg() || ownsDemoBucket(resource.data.orgId) || isAdmin());
      allow create: if signedIn() && (request.resource.data.orgId == userOrg() || ownsDemoBucket(request.resource.data.orgId));
      allow update: if signedIn()
                    && (resource.data.orgId == userOrg() || ownsDemoBucket(resource.data.orgId) || isAdmin())
                    && request.resource.data.orgId == resource.data.orgId;
      allow delete: if signedIn() && (resource.data.orgId == userOrg() || ownsDemoBucket(resource.data.orgId) || isAdmin());
    }

    match /om_tickets/{id} {
      allow read:   if signedIn() && (resource.data.orgId == userOrg() || ownsDemoBucket(resource.data.orgId) || isAdmin());
      allow create: if signedIn() && (request.resource.data.orgId == userOrg() || ownsDemoBucket(request.resource.data.orgId));
      allow update: if signedIn()
                    && (resource.data.orgId == userOrg() || ownsDemoBucket(resource.data.orgId) || isAdmin())
                    && request.resource.data.orgId == resource.data.orgId;
      allow delete: if signedIn() && (resource.data.orgId == userOrg() || ownsDemoBucket(resource.data.orgId) || isAdmin());
    }

    match /om_techs/{id} {
      allow read:   if signedIn() && (resource.data.orgId == userOrg() || ownsDemoBucket(resource.data.orgId) || isAdmin());
      allow create: if signedIn() && (request.resource.data.orgId == userOrg() || ownsDemoBucket(request.resource.data.orgId));
      allow update: if signedIn()
                    && (resource.data.orgId == userOrg() || ownsDemoBucket(resource.data.orgId) || isAdmin())
                    && request.resource.data.orgId == resource.data.orgId;
      allow delete: if signedIn() && (resource.data.orgId == userOrg() || ownsDemoBucket(resource.data.orgId) || isAdmin());
    }

    /* Integration hub (NON-SECRET metadata only; credentials live server-side
       in the om-integrations proxy). Doc id = orgId. Shared by the O&M,
       SLA, and Field Service tools for alert routing. */
    match /om_integrations/{orgId} {
      allow read:  if signedIn() && (orgId == userOrg() || ownsDemoBucket(orgId) || isAdmin());
      allow write: if signedIn() && (orgId == userOrg() || ownsDemoBucket(orgId) || isAdmin());
    }

    /* -------- SLA & Contractual Intelligence -------- */
    match /sla_contracts/{id} {
      allow read:   if signedIn() && (resource.data.orgId == userOrg() || ownsDemoBucket(resource.data.orgId) || isAdmin());
      allow create: if signedIn() && (request.resource.data.orgId == userOrg() || ownsDemoBucket(request.resource.data.orgId));
      allow update: if signedIn()
                    && (resource.data.orgId == userOrg() || ownsDemoBucket(resource.data.orgId) || isAdmin())
                    && request.resource.data.orgId == resource.data.orgId;
      allow delete: if signedIn() && (resource.data.orgId == userOrg() || ownsDemoBucket(resource.data.orgId) || isAdmin());
    }

    match /sla_events/{id} {
      allow read:   if signedIn() && (resource.data.orgId == userOrg() || ownsDemoBucket(resource.data.orgId) || isAdmin());
      allow create: if signedIn() && (request.resource.data.orgId == userOrg() || ownsDemoBucket(request.resource.data.orgId));
      allow update: if signedIn()
                    && (resource.data.orgId == userOrg() || ownsDemoBucket(resource.data.orgId) || isAdmin())
                    && request.resource.data.orgId == resource.data.orgId;
      allow delete: if signedIn() && (resource.data.orgId == userOrg() || ownsDemoBucket(resource.data.orgId) || isAdmin());
    }

    match /sla_breaches/{id} {
      allow read:   if signedIn() && (resource.data.orgId == userOrg() || ownsDemoBucket(resource.data.orgId) || isAdmin());
      allow create: if signedIn() && (request.resource.data.orgId == userOrg() || ownsDemoBucket(request.resource.data.orgId));
      allow update: if signedIn()
                    && (resource.data.orgId == userOrg() || ownsDemoBucket(resource.data.orgId) || isAdmin())
                    && request.resource.data.orgId == resource.data.orgId;
      allow delete: if signedIn() && (resource.data.orgId == userOrg() || ownsDemoBucket(resource.data.orgId) || isAdmin());
    }

    /* -------- Field Service & Dispatch -------- */
    match /fs_calls/{id} {
      allow read:   if signedIn() && (resource.data.orgId == userOrg() || ownsDemoBucket(resource.data.orgId) || isAdmin());
      allow create: if signedIn() && (request.resource.data.orgId == userOrg() || ownsDemoBucket(request.resource.data.orgId));
      allow update: if signedIn()
                    && (resource.data.orgId == userOrg() || ownsDemoBucket(resource.data.orgId) || isAdmin())
                    && request.resource.data.orgId == resource.data.orgId;
      allow delete: if signedIn() && (resource.data.orgId == userOrg() || ownsDemoBucket(resource.data.orgId) || isAdmin());
    }

    match /fs_crews/{id} {
      allow read:   if signedIn() && (resource.data.orgId == userOrg() || ownsDemoBucket(resource.data.orgId) || isAdmin());
      allow create: if signedIn() && (request.resource.data.orgId == userOrg() || ownsDemoBucket(request.resource.data.orgId));
      allow update: if signedIn()
                    && (resource.data.orgId == userOrg() || ownsDemoBucket(resource.data.orgId) || isAdmin())
                    && request.resource.data.orgId == resource.data.orgId;
      allow delete: if signedIn() && (resource.data.orgId == userOrg() || ownsDemoBucket(resource.data.orgId) || isAdmin());
    }

    match /fs_signals/{id} {
      allow read:   if signedIn() && (resource.data.orgId == userOrg() || ownsDemoBucket(resource.data.orgId) || isAdmin());
      allow create: if signedIn() && (request.resource.data.orgId == userOrg() || ownsDemoBucket(request.resource.data.orgId));
      allow update: if signedIn()
                    && (resource.data.orgId == userOrg() || ownsDemoBucket(resource.data.orgId) || isAdmin())
                    && request.resource.data.orgId == resource.data.orgId;
      allow delete: if signedIn() && (resource.data.orgId == userOrg() || ownsDemoBucket(resource.data.orgId) || isAdmin());
    }

    /* -------- Owner Reporting & Audit --------
       Owns rpt_*; also READS om_sites / sla_* / fs_* above (same tenant,
       already scoped, so cross-tool reads succeed). */
    match /rpt_owners/{id} {
      allow read:   if signedIn() && (resource.data.orgId == userOrg() || ownsDemoBucket(resource.data.orgId) || isAdmin());
      allow create: if signedIn() && (request.resource.data.orgId == userOrg() || ownsDemoBucket(request.resource.data.orgId));
      allow update: if signedIn()
                    && (resource.data.orgId == userOrg() || ownsDemoBucket(resource.data.orgId) || isAdmin())
                    && request.resource.data.orgId == resource.data.orgId;
      allow delete: if signedIn() && (resource.data.orgId == userOrg() || ownsDemoBucket(resource.data.orgId) || isAdmin());
    }

    match /rpt_reports/{id} {
      allow read:   if signedIn() && (resource.data.orgId == userOrg() || ownsDemoBucket(resource.data.orgId) || isAdmin());
      allow create: if signedIn() && (request.resource.data.orgId == userOrg() || ownsDemoBucket(request.resource.data.orgId));
      allow update: if signedIn()
                    && (resource.data.orgId == userOrg() || ownsDemoBucket(resource.data.orgId) || isAdmin())
                    && request.resource.data.orgId == resource.data.orgId;
      allow delete: if signedIn() && (resource.data.orgId == userOrg() || ownsDemoBucket(resource.data.orgId) || isAdmin());
    }

    /* -------- Fleet Command --------
       Owns fc_*; also READS om_sites above. */
    match /fc_assets/{id} {
      allow read:   if signedIn() && (resource.data.orgId == userOrg() || ownsDemoBucket(resource.data.orgId) || isAdmin());
      allow create: if signedIn() && (request.resource.data.orgId == userOrg() || ownsDemoBucket(request.resource.data.orgId));
      allow update: if signedIn()
                    && (resource.data.orgId == userOrg() || ownsDemoBucket(resource.data.orgId) || isAdmin())
                    && request.resource.data.orgId == resource.data.orgId;
      allow delete: if signedIn() && (resource.data.orgId == userOrg() || ownsDemoBucket(resource.data.orgId) || isAdmin());
    }

    match /fc_sources/{id} {
      allow read:   if signedIn() && (resource.data.orgId == userOrg() || ownsDemoBucket(resource.data.orgId) || isAdmin());
      allow create: if signedIn() && (request.resource.data.orgId == userOrg() || ownsDemoBucket(request.resource.data.orgId));
      allow update: if signedIn()
                    && (resource.data.orgId == userOrg() || ownsDemoBucket(resource.data.orgId) || isAdmin())
                    && request.resource.data.orgId == resource.data.orgId;
      allow delete: if signedIn() && (resource.data.orgId == userOrg() || ownsDemoBucket(resource.data.orgId) || isAdmin());
    }
  }
}
